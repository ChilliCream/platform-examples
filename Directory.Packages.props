<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Aspire hosting and client integrations -->
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.4.6" />
    <PackageVersion Include="Aspire.Hosting.Azure.EventHubs" Version="13.4.6" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.4.6" />
    <PackageVersion Include="Aspire.Hosting.RabbitMQ" Version="13.4.6" />
    <PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.4.6" />
    <PackageVersion Include="Aspire.RabbitMQ.Client" Version="13.4.6" />
    <!-- Azure clients -->
    <PackageVersion Include="Azure.Messaging.EventHubs" Version="5.12.2" />
    <!-- Service defaults (resilience, discovery, telemetry) -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.8.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
    <!-- EF Core -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0-preview.6.26359.118" />
    <!-- Mocha -->
    <PackageVersion Include="Mocha" Version="16.6.1" />
    <PackageVersion Include="Mocha.Abstractions" Version="16.6.1" />
    <PackageVersion Include="Mocha.Analyzers" Version="16.6.1" />
    <PackageVersion Include="Mocha.EntityFrameworkCore.Postgres" Version="16.6.1" />
    <PackageVersion Include="Mocha.Hosting" Version="16.6.1" />
    <PackageVersion Include="Mocha.Mediator" Version="16.6.1" />
    <PackageVersion Include="Mocha.Transport.InMemory" Version="16.6.1" />
    <PackageVersion Include="Mocha.Transport.Postgres" Version="16.6.1" />
    <PackageVersion Include="Mocha.Transport.RabbitMQ" Version="16.6.1" />
  </ItemGroup>
</Project>

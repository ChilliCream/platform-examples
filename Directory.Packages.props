<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Aspire hosting and client integrations -->
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.4.6" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.4.6" />
    <PackageVersion Include="Aspire.Hosting.RabbitMQ" Version="13.4.6" />
    <PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.4.6" />
    <PackageVersion Include="Aspire.RabbitMQ.Client" Version="13.4.6" />
    <!-- Aspire AppHost transitive dependency -->
    <PackageVersion Include="MessagePack" Version="2.5.303" />
    <!-- Azure clients -->
    <!-- Service defaults (resilience, discovery, telemetry) -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.8.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
    <!-- EF Core -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0-preview.6.26359.118" />
    <!-- Nitro -->
    <PackageVersion Include="ChilliCream.Nitro" Version="16.7.3" />
    <PackageVersion Include="ChilliCream.Nitro.Aspire" Version="16.7.3" />
    <PackageVersion Include="ChilliCream.Nitro.Mocha" Version="16.7.3" />
    <PackageVersion Include="ChilliCream.Nitro.Mocha.Mediator" Version="16.7.3" />
    <!-- Mocha -->
    <PackageVersion Include="Mocha" Version="16.7.3" />
    <PackageVersion Include="Mocha.Abstractions" Version="16.7.3" />
    <PackageVersion Include="Mocha.Analyzers" Version="16.7.3" />
    <PackageVersion Include="Mocha.EntityFrameworkCore.Postgres" Version="16.7.3" />
    <PackageVersion Include="Mocha.Hosting" Version="16.7.3" />
    <PackageVersion Include="Mocha.Mediator" Version="16.7.3" />
    <PackageVersion Include="Mocha.Transport.InMemory" Version="16.7.3" />
    <PackageVersion Include="Mocha.Transport.Postgres" Version="16.7.3" />
    <PackageVersion Include="Mocha.Transport.RabbitMQ" Version="16.7.3" />
  </ItemGroup>
  <ItemGroup Label="MigrateFromBrighter">
    <PackageVersion Include="Npgsql" Version="10.0.3" Condition="$(MSBuildProjectName.StartsWith('MigrateFromBrighter.'))" />
    <PackageVersion Include="Paramore.Brighter" Version="10.8.1" />
    <PackageVersion Include="Paramore.Brighter.BoxProvisioning.PostgreSql" Version="10.8.1" />
    <PackageVersion Include="Paramore.Brighter.Extensions.DependencyInjection" Version="10.8.1" />
    <PackageVersion Include="Paramore.Brighter.MessagingGateway.RMQ.Async" Version="10.8.1" />
    <PackageVersion Include="Paramore.Brighter.Outbox.Hosting" Version="10.8.1" />
    <PackageVersion Include="Paramore.Brighter.Outbox.PostgreSql" Version="10.8.1" />
    <PackageVersion Include="Paramore.Brighter.PostgreSql" Version="10.8.1" />
    <PackageVersion Include="Paramore.Brighter.PostgreSql.EntityFrameworkCore" Version="10.8.1" />
    <PackageVersion Include="Paramore.Brighter.ServiceActivator.Extensions.DependencyInjection" Version="10.8.1" />
    <PackageVersion Include="Paramore.Brighter.ServiceActivator.Extensions.Hosting" Version="10.8.1" />
  </ItemGroup>
</Project>

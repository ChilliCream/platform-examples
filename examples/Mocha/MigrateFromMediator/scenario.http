@baseUrl = http://localhost:41103
@productId = 11111111-1111-1111-1111-111111111111
@missingOrderId = 22222222-2222-2222-2222-222222222222

### Place an order. Both OrderPlacedNotification handlers run.
# @name placeOrder
POST {{baseUrl}}/orders
Content-Type: application/json

{
  "productId": "{{productId}}",
  "quantity": 2
}

### Read the order returned by the preceding request.
@orderId = {{placeOrder.response.body.$.orderId}}
GET {{baseUrl}}/orders/{{orderId}}

### Reject an invalid command before starting a transaction.
POST {{baseUrl}}/orders
Content-Type: application/json

{
  "productId": "{{productId}}",
  "quantity": 0
}

### Exercise exception handling and rollback for a missing order.
POST {{baseUrl}}/orders/{{missingOrderId}}/cancel

### Cancel the order.
POST {{baseUrl}}/orders/{{orderId}}/cancel

### Confirm the updated state.
GET {{baseUrl}}/orders/{{orderId}}

### Query an unknown order.
GET {{baseUrl}}/orders/{{missingOrderId}}

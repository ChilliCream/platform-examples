<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>AotExample.OrderService</RootNamespace>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <RuntimeIdentifiers>linux-x64;linux-arm64;win-x64;osx-arm64;osx-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AotExample.Contracts\AotExample.Contracts.csproj" />
    <PackageReference Include="Mocha" />
    <PackageReference Include="Mocha.Abstractions" />
    <PackageReference Include="Mocha.Mediator" />
    <PackageReference Include="Mocha.Transport.RabbitMQ" />
    <PackageReference Include="Mocha.Analyzers" PrivateAssets="all" />
  </ItemGroup>
</Project>
